{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/potatohoney-p/weasley-assistant/mcp.schema.json",
  "title": "Weasley Assistant MCP configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["servers"],
  "properties": {
    "servers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "command": { "type": "string", "minLength": 1 },
          "args": {
            "type": "array",
            "maxItems": 256,
            "items": { "type": "string" },
            "default": []
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "default": {}
          }
        }
      }
    }
  }
}
